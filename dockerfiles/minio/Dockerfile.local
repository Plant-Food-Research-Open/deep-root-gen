# Compatibility build of the original MinIO release from its public official source.
# Docker Hub no longer serves the repository's historical minio/minio image.
FROM golang:1.20.14-bookworm@sha256:9fa9101141c01e9440216d32eb2b380b3c3079bea07aeab3546020cc91b3662c AS builder
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOPROXY=https://proxy.golang.org GOSUMDB=sum.golang.org
WORKDIR /src
ADD --checksum=sha256:c2d917657886208ac55f6da67afe39dd83e9572beae6c270246f885813609ba9 \
    https://codeload.github.com/minio/minio/tar.gz/394690dcfb1b80532d5785bbf5313a0e57b58a00 /tmp/minio.tar.gz
RUN tar -xzf /tmp/minio.tar.gz --strip-components=1 -C /src \
    && go build -mod=readonly -buildvcs=false -trimpath -p 2 -ldflags="-s -w" -o /out/minio .
FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 minio \
    && mkdir -p /data /licenses && chown minio:minio /data
COPY --from=builder /out/minio /usr/local/bin/minio
COPY --from=builder /src/LICENSE /licenses/LICENSE
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
    org.opencontainers.image.revision="394690dcfb1b80532d5785bbf5313a0e57b58a00" \
    org.opencontainers.image.version="RELEASE.2023-05-27T05-56-19Z-local" \
    org.opencontainers.image.licenses="AGPL-3.0"
USER minio
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data"]
